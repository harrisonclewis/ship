# Generated by ship from the server's app records. Do not edit; run `ship proxy sync`.

(common) {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
}

cloud.lewbox.com, dev.lewbox.com {
	import common
	@maintenance file {
		root /etc/caddy/maintenance
		try_files lewbox
	}
	handle @maintenance {
		header Retry-After 120
		respond "Maintenance in progress. Try again soon." 503
	}
	handle {
		reverse_proxy lewbox:8080
	}
}

lewbox.com {
	import common
	@maintenance file {
		root /etc/caddy/maintenance
		try_files lewbox-commerce
	}
	handle @maintenance {
		header Retry-After 120
		respond "Maintenance in progress. Try again soon." 503
	}
	handle {
		reverse_proxy lewbox-commerce:3000
	}
}

www.lewbox.com {
	@maintenance file {
		root /etc/caddy/maintenance
		try_files lewbox-commerce
	}
	handle @maintenance {
		header Retry-After 120
		respond "Maintenance in progress. Try again soon." 503
	}
	handle {
		redir https://lewbox.com{uri} permanent
	}
}
